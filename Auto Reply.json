    {
      "parameters": {
        "jsCode": "// === KONFIGURASI ===\nconst maxHistory = 20; // Batas jumlah chat\nconst myName = \"Eka\";  \nconst userLabel = \"User\"; \n\n// DAFTAR KATA KUNCI YANG HARUS DIHAPUS DARI HISTORY\n// Jika pesan mengandung kata-kata ini, dianggap bukan obrolan, tapi fitur bot.\nconst blacklistedKeywords = [\n  \"REMINDER SYSTEM\",\n  \"VIP MANAGEMENT\",\n  \"SYSTEM TOOLS\",\n  \"FITUR AI (GEMINI)\",\n  \"STATUS MONITOR\",\n  \"Connection Info\",\n  \"DEVICE INFORMATION\",\n  \"Pong!\",\n  \"TIKTOK NO WATERMARK\",\n  \"INFO GEMPA\",\n  \"LAPORAN CUACA\",\n  \"JADWAL SHOLAT\",\n  \"DAFTAR PENGINGAT\",\n  \"VIP MEMBER\",\n  \"PENGHAPUSAN SUKSES\"\n];\n\n// 1. AMBIL DATA\nconst inputData = $input.first().json;\nconst rawMessages = inputData.results?.data || []; \n\nlet historyList = [];\n\n// 2. LOOPING PESAN\nfor (const msg of rawMessages) {\n  \n  // Ambil isi pesan\n  const text = msg.content || \"\";\n\n  // === FILTER 1: SKIP PESAN KOSONG ===\n  if (!text.trim()) continue;\n\n  // === FILTER 2: SKIP MEDIA ===\n  // Kalau pesan berupa gambar/video/stiker, skip.\n  if (msg.media_type && msg.media_type !== \"\") continue;\n\n  // === FILTER 3: LOGIKA BERDASARKAN PENGIRIM ===\n  \n  // A. JIKA PENGIRIM ADALAH USER (ORANG LAIN)\n  if (!msg.is_from_me) {\n    // Skip jika user mengirim Command (diawali !, ., #, /)\n    // Contoh: \"!menu\", \".ping\" -> HILANGKAN\n    if (/^[!./#]/.test(text.trim())) continue;\n  }\n\n  // B. JIKA PENGIRIM ADALAH BOT (KITA SENDIRI)\n  if (msg.is_from_me) {\n    // Cek apakah pesan ini adalah \"Template Menu\" atau \"Laporan Sistem\"\n    // Kita cek apakah teks mengandung salah satu kata dari blacklistedKeywords\n    const isSystemMessage = blacklistedKeywords.some(keyword => text.includes(keyword));\n    \n    // Jika iya (misal ada tulisan \"REMINDER SYSTEM\"), maka SKIP.\n    if (isSystemMessage) continue;\n  }\n\n  // === FORMATTING ===\n  const sender = msg.is_from_me ? myName : userLabel;\n\n  // Masukkan ke daftar history\n  historyList.push(`${sender}: ${text}`);\n  \n  // Cek Limit\n  if (historyList.length >= maxHistory) break;\n}\n\n// 3. URUTKAN KRONOLOGIS (Lama -> Baru)\nhistoryList.reverse();\n\n// 4. GABUNG JADI TEXT\nconst finalHistory = historyList.join(\"\\n\");\n\n// 5. OUTPUT\nreturn {\n  json: {\n    history_context: finalHistory\n  }\n};"
      },
