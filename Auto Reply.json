    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const body = item.json.body || {};\n  \n  // === 1. PASTIKAN ADA OBJEK PESAN ===\n  const msg = body.message;\n  if (!msg) {\n    continue;\n  }\n\n  // === 2. FILTER DIRI SENDIRI (ANTI-LOOP) ===\n  // Cek key.fromMe atau body.fromMe\n  const key = body.key || msg.key || {};\n  // Jika terdeteksi dari bot sendiri, skip.\n  if (key.fromMe === true || body.fromMe === true) {\n    continue; \n  }\n\n  // === 3. FILTER GRUP & STATUS ===\n  const remoteJid = key.remoteJid || body.from || body.chat_id || \"\";\n  if (remoteJid.includes(\"@g.us\") || remoteJid.includes(\"status@broadcast\")) {\n    continue;\n  }\n\n  // === 4. AMBIL TEKS (BAGIAN INI YANG DIPERBAIKI) ===\n  let text = \"\";\n\n  // Cek struktur JSON kamu (body.message.text)\n  if (msg.text) {\n    text = msg.text; \n  } \n  // Cek struktur standar Baileys (conversation)\n  else if (msg.conversation) {\n    text = msg.conversation;\n  } \n  // Cek pesan panjang/reply\n  else if (msg.extendedTextMessage && msg.extendedTextMessage.text) {\n    text = msg.extendedTextMessage.text;\n  }\n\n  // Jika teks masih kosong (berarti isinya media/stiker), SKIP.\n  if (!text || text.trim().length === 0) {\n    continue;\n  }\n\n  // === 5. FILTER COMMAND (! . / #) ===\n  // Skip jika pesan diawali simbol command\n  if (/^[!./#]/.test(text.trim())) {\n    continue;\n  }\n\n  // === 6. SIAPKAN OUTPUT ===\n  const rawText = text.trim();\n  const normalizedMessage = rawText.toLowerCase(); \n  \n  // Ambil nomor HP bersih\n  const userPhone = remoteJid.split('@')[0];\n  \n  // Ambil Nama\n  const pushName = body.pushname || item.json.pushName || \"Teman\";\n\n  results.push({\n    json: {\n      ...item.json,\n      \n      // Data Bersih untuk AI:\n      userPhone: userPhone,         \n      chatId: remoteJid,            \n      originalMessage: rawText,     \n      normalizedMessage: normalizedMessage, \n      pushName: pushName,           \n      timestamp: Date.now()\n    }\n  });\n}\n\nreturn results;"
      },
